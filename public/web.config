<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap
        fileExtension=".woff"
        mimeType="font/woff" />

      <remove fileExtension=".woff2" />
      <mimeMap
        fileExtension=".woff2"
        mimeType="font/woff2" />
       <mimeMap fileExtension=".md" mimeType="text/markdown" />       
    </staticContent>
  </system.webServer>
</configuration>